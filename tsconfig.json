{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    // File Layout
    "rootDir": "./src",
    "outDir": "./dist",

    // Environment Settings
    "module": "nodenext", // Set to "esnext" for modern module syntax which allows us to use import/export statements in our code.
    "target": "esnext",
    // and npm install -D @types/node
    "lib": ["esnext", "dom"],
    "types": ["node"],

    // Other Outputs
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "removeComments": true, // to reduce the size of the output files, and to prevent accidentally exposing comments that might contain sensitive information.

    // Style Options
    "noImplicitReturns": true, // to catch functions that don't return a value in all code paths.
    "noImplicitOverride": true, // // Set to true if you want to catch missing override modifiers.
    "noUnusedLocals": false, // to catch variables that are declared but not used anywhere in the code.
    "noUnusedParameters": true, // to catch function parameters that are declared but not used anywhere in the code.
    // "noFallthroughCasesInSwitch": true,
    // "noPropertyAccessFromIndexSignature": true,
    // "strictNullChecks": false, // to catch null and undefined values in the code.
    "noEmitOnError": false,
    "allowUnreachableCode": false,

    // Recommended Options
    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": false, // switchs between CommonJS and ES module syntax based on the "module" option. Set to false if you want to use ES module syntax in your code, even if the "module" option is set to "commonjs" or "nodenext".
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "noImplicitAny": true // Set to true if you want to catch implicit any types. Default is true in strict mode.
    // setting this to false can improve editor experience when working with data like documents without types, but it may lead to less type safety.
  }
}
